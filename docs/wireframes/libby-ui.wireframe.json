{
  "$comment": "Low-fidelity wireframe spec for the libby-shelf UI (ui/). Edit `options` and per-item `enabled` to reconfigure. See README.md.",
  "version": 1,
  "options": {
    "layout": "desktop",
    "density": "comfortable",
    "navigation": "sidebar",
    "defaultScreen": "shelf",
    "showAdvanced": false
  },
  "screens": [
    {
      "id": "sync",
      "title": "Sync",
      "cli": "",
      "enabled": true,
      "regions": [
        {
          "id": "rules",
          "components": [
            {
              "type": "rule",
              "label": "Libby determines reading progress, checked-out status, and finished books."
            },
            {
              "type": "rule",
              "label": "For other fields, the most recent edit wins. Missing or tied timestamps need review."
            },
            {
              "type": "button",
              "label": "Sync",
              "action": "sync-preview",
              "primary": true
            },
            { "type": "button", "label": "Apply selected changes", "action": "sync-apply", "confirm": true },
            {
              "type": "rule",
              "label": "Finished wins. Otherwise Currently Reading requires a checked-out Libby book with progress above zero."
            },
            {
              "type": "rule",
              "label": "Removals default to off. Every removal needs explicit review."
            }
          ]
        },
        {
          "id": "comparison",
          "components": [
            {
              "type": "table",
              "label": "Library",
              "columns": ["book", "field", "libby", "fable", "value", "source"]
            }
          ]
        }
      ]
    },
    {
      "id": "connect",
      "title": "Connect Libby",
      "cli": "login",
      "enabled": true,
      "regions": [
        {
          "id": "status",
          "components": [{ "type": "banner", "label": "Connection status", "binds": "auth.tokenFile" }]
        },
        {
          "id": "form",
          "components": [
            {
              "type": "output",
              "input": "code",
              "label": "8-digit setup code",
              "hint": "Enter this code on your existing Libby device: Menu → Copy To Another Device → Enter Setup Code"
            },
            { "type": "field", "input": "path", "label": "Token file", "binds": "auth.tokenFile", "advanced": true },
            { "type": "button", "label": "Sign in to Libby", "action": "login" }
          ]
        }
      ]
    },
    {
      "id": "cards",
      "title": "Library cards",
      "cli": "cards",
      "enabled": true,
      "regions": [
        {
          "id": "table",
          "components": [
            {
              "type": "table",
              "label": "Cards",
              "columns": ["use", "cardName", "priority", "loans", "holds"],
              "binds": "cards"
            },
            {
              "type": "reorder",
              "label": "Library priority (highest first; unchecked cards last and fixed)",
              "binds": "libraries"
            }
          ]
        }
      ]
    },
    {
      "id": "books",
      "title": "Book list",
      "cli": "run <input>",
      "enabled": true,
      "regions": [
        {
          "id": "input",
          "components": [
            {
              "type": "textarea",
              "label": "One book per line: Title by Author · isbn:… · id:…"
            },
            {
              "type": "dropzone",
              "label": "Or drop .txt / .csv / .tsv / .json"
            },
            {
              "type": "select",
              "label": "Input format",
              "options": ["auto", "text", "csv", "tsv", "json"]
            }
          ]
        },
        {
          "id": "rows",
          "components": [
            {
              "type": "table",
              "label": "Parsed books",
              "columns": ["title", "author", "isbn", "format", "action", "libraries"],
              "editable": ["format", "action", "libraries"]
            }
          ]
        },
        {
          "id": "actions",
          "components": [
            {
              "type": "toggle",
              "label": "Dry run",
              "binds": "dryRun"
            },
            {
              "type": "button",
              "label": "Plan",
              "action": "run --dry-run",
              "primary": true
            }
          ]
        }
      ]
    },
    {
      "id": "shelf",
      "title": "Shelf",
      "cli": "",
      "enabled": true,
      "regions": [
        {
          "id": "shelf",
          "components": [
            { "type": "tabs", "label": "Shelf", "options": ["Checked out", "Holds", "Returned"] },
            {
              "type": "list",
              "label": "Shelf entries",
              "columns": ["title", "author", "narrators", "cardName", "mediaType", "holdListPosition"]
            }
          ]
        }
      ]
    },
    {
      "id": "settings",
      "title": "Rules",
      "cli": "config",
      "enabled": true,
      "regions": [
        {
          "id": "general",
          "components": [
            { "type": "segmented", "label": "Action", "binds": "action" },
            { "type": "list", "label": "Media types (preference order)", "input": "ordered", "binds": "mediaTypes" },
            { "type": "toggle", "label": "Skip titles already on shelf", "binds": "skipExisting" },
            { "type": "toggle", "label": "Respect card limits", "binds": "respectCardLimits" }
          ]
        },
        {
          "id": "borrow",
          "components": [
            { "type": "select", "label": "Lending period", "binds": "borrow.lendingPeriod" },
            { "type": "toggle", "label": "Allow Lucky Day copies", "binds": "borrow.luckyDay" },
            { "type": "number", "label": "Max loans per run", "binds": "borrow.maxPerRun" }
          ]
        },
        {
          "id": "hold",
          "components": [
            { "type": "segmented", "label": "Placement", "binds": "hold.placement" },
            { "type": "number", "label": "Max estimated wait (days)", "binds": "hold.maxEstimatedWaitDays" },
            { "type": "number", "label": "Max people in queue", "binds": "hold.maxHoldsCount" },
            { "type": "select", "label": "Deliver later (days)", "binds": "hold.suspendDays" },
            { "type": "field", "input": "email", "label": "Hold email", "binds": "hold.emailAddress" },
            { "type": "number", "label": "Max holds per run", "binds": "hold.maxPerRun" }
          ]
        },
        {
          "id": "matching",
          "advanced": true,
          "components": [
            { "type": "slider", "label": "Title match threshold", "binds": "matching.minTitleScore" },
            { "type": "slider", "label": "Author match threshold", "binds": "matching.minAuthorScore" },
            { "type": "toggle", "label": "Ignore subtitles", "binds": "matching.ignoreSubtitle" },
            { "type": "toggle", "label": "Allow pre-release titles", "binds": "matching.allowPreRelease" },
            { "type": "number", "label": "Results examined per library", "binds": "matching.perPage" }
          ]
        },
        {
          "id": "network",
          "advanced": true,
          "components": [
            { "type": "number", "label": "Delay between books (ms)", "binds": "delayMs" },
            { "type": "toggle", "label": "Stop on first error", "binds": "failFast" },
            { "type": "number", "label": "Request timeout (ms)", "binds": "http.timeoutMs" },
            { "type": "number", "label": "Retries", "binds": "http.retries" }
          ]
        }
      ]
    },
    {
      "id": "search",
      "title": "Search",
      "cli": "search <query>",
      "enabled": true,
      "regions": [
        {
          "id": "query",
          "components": [
            { "type": "field", "input": "search", "label": "Search books" },
            { "type": "button", "label": "Search", "action": "search" },
            { "type": "button", "label": "Add tags" }
          ]
        },
        {
          "id": "matches",
          "components": [
            {
              "type": "list",
              "label": "Matches grouped by title and author",
              "columns": [
                "card",
                "title",
                "author",
                "type",
                "narrators",
                "isAvailable",
                "availableCopies",
                "ownedCopies",
                "holdsCount",
                "estimatedWaitDays"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "results",
      "title": "Plan & results",
      "cli": "run",
      "enabled": true,
      "regions": [
        {
          "id": "summary",
          "components": [
            {
              "type": "stats",
              "label": "Counts by status",
              "values": ["borrowed", "held", "would-borrow", "would-hold", "skipped", "error"]
            },
            { "type": "chips", "label": "Filter by status", "values": ["all", "borrowed", "held", "skipped", "error"] }
          ]
        },
        {
          "id": "table",
          "components": [
            {
              "type": "table",
              "label": "One row per book per library",
              "columns": [
                "status",
                "title",
                "author",
                "mediaType",
                "library",
                "cardName",
                "loanDays",
                "estimatedWaitDays",
                "holdsCount",
                "message"
              ]
            }
          ]
        },
        {
          "id": "actions",
          "components": [
            { "type": "button", "label": "Run for real", "action": "run", "primary": true, "confirm": true },
            { "type": "button", "label": "Export report", "action": "export", "binds": "output.reportFile" }
          ]
        }
      ]
    },
    {
      "id": "player",
      "title": "Audiobook player",
      "cli": "",
      "enabled": true,
      "regions": [
        {
          "id": "now-playing",
          "components": [
            { "type": "output", "label": "Now playing", "hint": "Demo title. Libby audio is not streamed." },
            { "type": "slider", "label": "Position" }
          ]
        },
        {
          "id": "transport",
          "components": [
            { "type": "button", "label": "Beginning of chapter", "action": "player-chapter-start" },
            { "type": "button", "label": "Rewind 30 seconds", "action": "player-rewind" },
            { "type": "button", "label": "Play / pause", "action": "player-toggle", "primary": true },
            { "type": "button", "label": "Fast forward 30 seconds", "action": "player-forward" },
            { "type": "button", "label": "End of chapter", "action": "player-chapter-end" }
          ]
        },
        {
          "id": "speed",
          "components": [
            { "type": "button", "label": "Slower (−5%)", "action": "player-slower" },
            { "type": "output", "label": "Playback speed" },
            { "type": "button", "label": "Faster (+5%)", "action": "player-faster" }
          ]
        },
        {
          "id": "bookmarks",
          "components": [
            {
              "type": "button",
              "label": "Bookmarks",
              "action": "player-open-bookmarks",
              "hint": "Phone only: opens bookmarks full screen."
            },
            { "type": "button", "label": "Add bookmark", "action": "player-bookmark" },
            {
              "type": "button",
              "label": "Save",
              "action": "player-save-bookmarks",
              "primary": true,
              "hint": "Phone sheet: commits draft edits and returns to the player."
            },
            { "type": "confirm", "label": "Discard changes?", "hint": "Unsaved notes and tags will be lost." },
            { "type": "filter", "label": "Filter by tag" },
            {
              "type": "menu",
              "label": "Add tag",
              "hint": "Bookmark tags only. Scrolls. New Tag is always last and is the only way to create a tag."
            },
            { "type": "button", "label": "New Tag", "action": "player-new-tag" },
            { "type": "table", "label": "Bookmarks", "columns": ["position", "chapter", "note", "tags"] }
          ]
        }
      ]
    }
  ]
}
